# קובץ זה נחוץ רק למי שמריץ את השרת המקומי.
# באירוח סטטי אין שרת בכלל, וכל משתמש מכניס מפתח משלו בלוח ההורים.

# מפתח API של Anthropic. כשהוא קיים, הדפדפן יכול לבקש מהשרת המקומי
# לדבר עם עגלי במקומו — וכך המפתח לא נשמר בדפדפן של אף אחד.
# בלעדיו כל שאר המשחק עובד: חידות, רמזים, בדיקת תשובות, פרופילים ורמות.
ANTHROPIC_API_KEY=

# פורט השרת (ברירת מחדל 5174)
PORT=5174
