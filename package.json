{
  "name": "miani",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "עגלי — משחק חידות מי אני בסופר, בעברית, לילדים בגילאי 4-10. רץ כאתר סטטי, כל הנתונים על המכשיר.",
  "scripts": {
    "dev": "concurrently -n server,web -c green,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "report:typos": "tsx scripts/typo-report.ts",
    "report:collisions": "tsx scripts/collision-report.ts",
    "merge:nikud": "tsx scripts/merge-nikud.ts",
    "riddles:write": "tsx scripts/write-riddles.ts",
    "riddles:promote": "tsx scripts/promote-drafts.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
